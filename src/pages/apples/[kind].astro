---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
    return [
        {params: {kind: "fuji"}},
        {params: {kind: "gala"}},
        {params: {kind: "macintosh"}},
    ]
}

const { kind } = Astro.params;

---

<Layout>
<h1>Apple: {kind}</h1>
<p>This page is about <b>{kind}</b> apples</p>
<a href="/apples">Back</a>
</Layout>