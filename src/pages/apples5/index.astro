---
import Layout from "../../layouts/Layout.astro";
import { apples } from "../../data/apples-with-info.json";
import Apple from "../../components/Apple.astro";
---

<Layout>
<div class="container">
    <h1>Apples v5</h1>
    <div class="grid">
        {
            apples.map((apple) => <Apple name={apple.name} info={apple.info}></Apple>)
        }
    </div>
    <div class="nav"><a href="/">Return home</a></div>
</div>

<style>
  .container {
    padding: 2rem;
  }

  h1 {
    margin-bottom: 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

</style>
</Layout>