---
import Layout from "../../layouts/Layout.astro";
import { apples } from "../../data/apples.json";
---

<Layout>
<div>
    <h1>Apples v3</h1>
    <ul>
        {apples.map((apple) => {
            return <li><a href={`/apples3/`+apple}>{apple} Apple</a></li>;
        })}
    </ul>
    <div><a href="/">Return home</a></div>
</div>
</Layout>